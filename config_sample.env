# =============================================================
# Rename this file to config.env before using
# =============================================================

####################
## REQUIRED SETTINGS
####################

# Telegram API credentials (from https://my.telegram.org/apps)
API_ID=0 # Example: 1234567
API_HASH="" # Example: "abc123def456"

# Bot token (from @BotFather)
BOT_TOKEN="" # Example: "123456789:ABCdef..."

# Storage channel ID - Primary (Required: create a channel and add bot as admin)
BIN_CHANNEL=0 # Example: -1001234567890

# Optional extra storage channels: BIN_CHANNEL_2, BIN_CHANNEL_3, ...
# Files are spread over the configured channels by a stable hash of their
# identity, and each file is served by the pool bots that administer its channel.
# Use this when your pool has more bots than one channel can hold: Telegram caps
# channel administrators (bots included) at 50. The bots needed per channel are
# logged at boot ("BIN_CHANNEL_2 (-100...): 12 client(s)").
# Example for 2nd and 3rd storage channels (uncomment and replace with your channel IDs):
# BIN_CHANNEL_2=-1009876543210
# BIN_CHANNEL_3=-1001122334455

# Owner information (get ID from @userinfobot)
OWNER_ID=0 # Your Telegram user ID. Example: 123456789

# Database connection string
DATABASE_URL="" # Example: "mongodb+srv://user:pass@host/db"

# Deployment configuration
FQDN="" # Your domain name
HAS_SSL="True" # Set to "True" if using HTTPS
PORT=8080 # Web server port
NO_PORT="True" # Hide port in URLs ("True" or "False")

####################
## OPTIONAL SETTINGS
####################

MAX_BATCH_FILES=50

# Maximum simultaneous streams a single caller (viewer IP) may hold open.
# Players open several range requests at once; lower this only to fight abuse.
MAX_CONCURRENT_PER_USER=8

# Hours a newly created link stays valid (0 = never expires).
# Revoke an individual link any time with /revoke <hash>.
LINK_TTL_HOURS=0

# Let users send a direct URL and get a Cloud Station link back.
# Telegram downloads the URL itself; nothing is fetched from your host.
URL_UPLOAD_ENABLED="True"

################
## WEB ADMIN DASHBOARD
################

# Password for the /admin dashboard (live stats, bot pool health, active
# callers, IP ban/unban). Leave empty to disable the dashboard completely -
# without a password every /admin request is refused.
# Sessions are signed cookies valid for 12h; changing this value or restarting
# the process logs everyone out.
WEB_ADMIN_PASSWORD=""

# DM the owner when streams start failing repeatedly
ALERT_ON_STREAM_FAILURES="True"
STREAM_FAILURE_ALERT_THRESHOLD=5
STREAM_FAILURE_ALERT_WINDOW_MINUTES=5

# Set bot commands on startup (True/False)
SET_COMMANDS="True"

# Force users to join a specific channel before using the bot
FORCE_CHANNEL_ID="" # Example: -1001234567890 (Leave empty if not needed)

# Allow processing of channel messages (True/False)
CHANNEL="False"

# Banned channels (files from these channels will be rejected)
BANNED_CHANNELS="" # Example: "-1001234567890 -100987654321" (Space-separated IDs, leave empty if none)

# Extra bot tokens for the streaming pool. Add as many as you need:
# MULTI_TOKEN1, MULTI_TOKEN2, ... MULTI_TOKEN150, ... (no upper limit).
# Only the exact form MULTI_TOKEN<number> is read; anything else (e.g.
# MULTI_TOKEN1_BACKUP) is ignored with a warning in the log.
# Every one of these bots must be an administrator of BIN_CHANNEL, and Telegram
# caps administrators per channel - split a very large pool over more channels.
# Example: MULTI_TOKEN49="123456789:ABCdef..."
MULTI_TOKEN1=""

####################
## TOKEN SYSTEM SETTINGS
####################

# Enable token-based access (True/False)
TOKEN_ENABLED="False"

# Default token validity in hours
TOKEN_TTL_HOURS="24"

####################
## URL SHORTENER SETTINGS
####################

# Enable URL shortening for tokens (True/False)
SHORTEN_ENABLED="False"

# Enable URL shortening for media links (True/False)
SHORTEN_MEDIA_LINKS="False"

# URL Shortener
URL_SHORTENER_API_KEY="" # Example: "abc123def456"
URL_SHORTENER_SITE="" # Example: "example.com"

####################
## GLOBAL RATE LIMITING SETTINGS
####################

# Enable global rate limiting (True/False)
GLOBAL_RATE_LIMIT="False"

# Maximum number of requests allowed across all users per minute
MAX_GLOBAL_REQUESTS_PER_MINUTE=4

####################
## RATE LIMITING SETTINGS
####################

# Enable rate limiting (True/False)
RATE_LIMIT_ENABLED="False"

MAX_FILES_PER_PERIOD=2

# Time window in minutes for rate limiting
RATE_LIMIT_PERIOD_MINUTES=1

# Maximum number of requests that can be queued.
MAX_QUEUE_SIZE=100

####################
## UPDATE SETTINGS
####################

# Git repository for updates (Whichever repo you set here will be fetched and booted on startup)
UPSTREAM_REPO="https://github.com/mdsaif572/FileToLinksssss" # Example: "https://github.com/your-username/your-repo"

# Branch to update and boot from
UPSTREAM_BRANCH="main" # Default branch for updates (e.g., "main" or "master")

####################
## DATABASE OPTIMIZATION SETTINGS
####################

# MongoDB connection pool settings
MONGO_MAX_POOL_SIZE=200 # Maximum number of connections in the pool
MONGO_MIN_POOL_SIZE=20 # Minimum number of connections in the pool
MONGO_CONNECT_TIMEOUT_MS=5000 # Connection timeout in milliseconds
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000 # Server selection timeout in milliseconds

# Read preference for MongoDB operations
MONGO_READ_PREFERENCE="secondaryPreferred" # Use secondary replicas for read operations when possible

####################
## ADVANCED SETTINGS (modify with caution)
####################

# Application name
NAME="CloudStationF2L" # Bot application name

# Performance settings
# FloodWait handling: the client waits this long instead of raising. Keep it LOW
# (30-60) when you run a multi-client pool - a throttled bot should be rotated
# away rather than make one request wait minutes, and the streaming path has its
# own 20s per-chunk timeout.
SLEEP_THRESHOLD=60

# Concurrent update handlers. "Dropping <update> after 5s: handlers cannot keep
# up with the update rate" in the log means this is too low for your traffic
# (pyrogram's update queue holds 256 items). Raise it (32-64) or reduce work per
# handler.
WORKERS=8

# Web server configuration
BIND_ADDRESS="0.0.0.0" # Listen on all network interfaces
PING_INTERVAL=840 # Ping interval in seconds

